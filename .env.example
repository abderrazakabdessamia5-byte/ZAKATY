# ZakaTy Environment Variables Example
# Duplicate this file to .env for local overrides

# APP_URL: The public URL where this applet is hosted (e.g. https://zakaty.tools or development URL)
APP_URL="https://zakaty.tools"

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Web Client ID for Google Sign-In
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=""
